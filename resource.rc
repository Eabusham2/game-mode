#include <windows.h>

/* Keep in sync with IDI_APPICON in src/gamemode.h */
#define IDI_APPICON 101

/* Embed the application manifest (visual styles + admin elevation). */
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

/* Application icon (window + taskbar + system tray). */
IDI_APPICON ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GameMode"
            VALUE "FileDescription",  "GameMode - System Optimizer"
            VALUE "FileVersion",      "3.0.0.0"
            VALUE "InternalName",     "GameMode"
            VALUE "OriginalFilename", "GameMode.exe"
            VALUE "ProductName",      "GameMode"
            VALUE "ProductVersion",   "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
